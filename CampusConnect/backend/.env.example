PORT=5000

# MongoDB Atlas connection string (rotate the credentials before using —
# any values that shipped in the old .env were exposed and should be treated as compromised)
MONGO_URI="mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority"

# Generate a new random secret, e.g.: openssl rand -base64 48
JWT_SECRET=

# https://aistudio.google.com/apikey — issue a fresh key
GEMINI_API_KEY=

# Comma-separated list of deployed frontend URLs allowed to call this API
# e.g. https://campusconnect.onrender.com,https://campusconnect-admin.onrender.com
ALLOWED_ORIGINS=
