# URL where the admin module (project/project) is running.
# The "Sign in as Admin" button on the login page links here.
# Defaults to http://localhost:5174 if not set — see
# project/project/vite.config.js for that app's dev port.
VITE_ADMIN_URL=http://localhost:5174

# URL of the deployed backend API, e.g. https://campusconnect-api.onrender.com
VITE_API_URL=http://localhost:5000
